					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate SHA512 signature key automatically before sending request",
									"const body = JSON.parse(pm.request.body.raw || '{}');",
									"const orderId = body.order_id || 'APT-20260805-A3F9';",
									"const statusCode = body.status_code || '200';",
									"const grossAmount = body.gross_amount || '75000.00';",
									"const serverKey = pm.variables.get('midtrans_server_key') || 'SB-Mid-server-4CqWyer3xdI91epy9bDd2pBk';",
									"",
									"const signatureInput = orderId + statusCode + grossAmount + serverKey;",
									"const signatureKey = CryptoJS.SHA512(signatureInput).toString();",
									"",
									"pm.variables.set('calc_signature_key', signatureKey);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
