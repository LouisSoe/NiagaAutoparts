# Server
APP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=secret
DB_NAME=autoparts_db

# In-Memory Cache (no Redis needed)
CACHE_PRODUCT_TTL_SECONDS=60       # How long product search results are cached
CACHE_CLEANUP_INTERVAL_SECONDS=120 # How often expired entries are swept

# Fonnte WhatsApp Gateway
FONNTE_TOKEN=YOUR_FONNTE_TOKEN_HERE
FONNTE_API_URL=https://api.fonnte.com/send

# Google AI Studio (Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash-latest
GEMINI_TIMEOUT_SEC=3

# Worker
WORKER_POOL_SIZE=10
WORKER_QUEUE_SIZE=100

# Session
SESSION_TTL_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_BURST=10

# Telegram Bot
TELE_API=YOUR_TELEGRAM_BOT_TOKEN_HERE