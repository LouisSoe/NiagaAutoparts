# Server
APP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=secret
DB_NAME=autoparts_db

# In-Memory Cache (no Redis needed)
CACHE_PRODUCT_TTL_SECONDS=60       # How long product search results are cached
CACHE_CLEANUP_INTERVAL_SECONDS=120 # How often expired entries are swept

# Fonnte WhatsApp Gateway
FONNTE_TOKEN=YOUR_FONNTE_TOKEN_HERE
FONNTE_API_URL=https://api.fonnte.com/send

# Google AI Studio (Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash-latest
GEMINI_TIMEOUT_SEC=3

# Worker
WORKER_POOL_SIZE=10
WORKER_QUEUE_SIZE=100

# Session
SESSION_TTL_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_BURST=10

# Telegram Bot 1: Customer Service Chatbot (Customer Facing)
TELE_API=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Bot 2: Notifier & System Alert Bot (Channel Broadcaster)
TELEGRAM_NOTIFIER_BOT_TOKEN=YOUR_NOTIFIER_BOT_TOKEN_HERE
TELEGRAM_ORDER_CHANNEL_ID=@channel_pesanan_autoparts  # atau ID channel e.g. -100123456789
TELEGRAM_ERROR_CHANNEL_ID=@channel_error_autoparts    # atau ID channel e.g. -100987654321
# Telegram Bot 3: Courier Delivery Assistant Bot
TELEGRAM_COURIER_BOT_TOKEN=YOUR_COURIER_BOT_TOKEN_HERE
COURIER_REMINDER_MODE=interval            # "daily" (jam tertentu) atau "interval" (per menit/jam untuk testing)
COURIER_REMINDER_INTERVAL_MINUTES=1       # Interval dalam menit saat mode=interval (misal: 1 untuk testing, 60 untuk 1 jam)
COURIER_REMINDER_HOUR=5                   # Jam reminder saat mode=daily (0-23 WIB)
COURIER_REMINDER_MINUTE=0                 # Menit reminder saat mode=daily (0-59)

# Midtrans Payment Gateway
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js #change if run production

# Google Maps Distance
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=true